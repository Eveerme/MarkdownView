{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownView",
  "version": "1.0.0",
  "identifier": "com.markdownview.desktop",
  "build": {
    "beforeBuildCommand": "pnpm exec vp run --filter @markdownview/web build",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkdownView",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost mdview:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: mdview: asset: http://asset.localhost",
        "connect-src": "'self' mdview: ipc: http://ipc.localhost ws://localhost:5173"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "MarkdownView.Document",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
